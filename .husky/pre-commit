#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-commit hook: Run code quality checks
# These checks ensure code meets standards before committing

echo "🔍 Running pre-commit checks..."

# 1. Check code formatting
echo "\n📝 Checking code formatting..."
pnpm format:check || {
  echo "❌ Code formatting check failed. Run 'pnpm format' to fix."
  exit 1
}

# 2. Run linter
echo "\n🔎 Running linter..."
pnpm lint || {
  echo "❌ Linting failed. Please fix the issues above."
  exit 1
}

# 3. Run unit and integration tests (fast)
echo "\n🧪 Running tests..."
pnpm test || {
  echo "❌ Tests failed. Please fix the failing tests."
  exit 1
}

echo "\n✅ All pre-commit checks passed!"
